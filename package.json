{
  "name": "org-mode",
  "version": "1.0.0",
  "description": "",
  "author": "Naoya Yamashita <conao3@gmail.com>",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.9.0",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.80.1"
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -p ./ -w"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "typescript": "^7.0.2"
  },
  "activationEvents": [
    "onLanguage:org-mode"
  ],
  "contributes": {
    "languages": [
      {
        "id": "org-mode",
        "extensions": [
          ".org"
        ]
      }
    ],
    "commands": [
      {
        "command": "org-mode.hello",
        "title": "org-mode: hello"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  }
}
